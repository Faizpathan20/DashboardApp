<!-- ================= CHART JS ================= -->


<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>



<script>


// ================= HERO SLIDER =================


let slides =
document.querySelectorAll(".hero-slide");


let currentSlide = 0;



function changeSlide(index)
{

slides[currentSlide]
.classList.remove("active");


currentSlide=index;


slides[currentSlide]
.classList.add("active");


}



setInterval(()=>{


let next =
(currentSlide+1)%slides.length;


changeSlide(next);


},5000);






function scrollToDashboard()
{

document
.getElementById("dashboard")
.scrollIntoView(
{
behavior:"smooth"
});

}







// ================= CLIENT CHART =================


new Chart(
document.getElementById("topClientsChart"),
{

type:"bar",

data:
{

labels:@Html.Raw(topClientLabels),


datasets:[{

data:@Html.Raw(topClientValues),

backgroundColor:"#2563eb",

borderRadius:8

}]

},


options:
{

responsive:true,

maintainAspectRatio:false,


plugins:
{

legend:
{

display:false

}

}

}


});








// ================= COLOUR CHART =================


new Chart(
document.getElementById("colourChart"),
{


type:"doughnut",


data:
{

labels:@Html.Raw(colourLabelsJson),


datasets:[{


data:@Html.Raw(colourValuesJson),


backgroundColor:
[
"#2563eb",
"#16a34a",
"#9333ea",
"#ea580c",
"#64748b"
]


}]


},



options:
{

responsive:true,

maintainAspectRatio:false,


cutout:"65%"

}



});









// ================= TABLE FILTER =================


let pageSize=25;

let currentPage=1;



function getRows()
{

return Array.from(
document.querySelectorAll(".data-row")
);

}




function applyFilters()
{

currentPage=1;

renderTable();

}






function renderTable()
{


let rows=getRows();


let search =
document
.getElementById("searchInput")
.value
.toLowerCase();



let filtered =
rows.filter(row=>{


return row.innerText
.toLowerCase()
.includes(search);


});



rows.forEach(r=>
r.style.display="none"
);



let start =
(currentPage-1)*pageSize;



let end =
start+pageSize;



filtered
.slice(start,end)
.forEach(r=>
r.style.display=""
);



document
.getElementById("recordCount")
.innerText =
"Showing "
+
filtered.length
+
" records";



}





function changePageSize()
{

let value =
document
.getElementById("pageSize")
.value;



pageSize =
value==="all"
?999999
:parseInt(value);



renderTable();


}







// ================= CSV EXPORT =================


function exportCSV()
{


let table =
document
.getElementById("dashboardTable");


let csv=[];



table
.querySelectorAll("tr")
.forEach(row=>{


let cols =
Array.from(
row.children
)
.map(
cell=>'"'+cell.innerText+'"'
);


csv.push(cols.join(","));


});




let blob =
new Blob(
[csv.join("\n")],
{
type:"text/csv"
});



let link =
document.createElement("a");


link.href =
URL.createObjectURL(blob);


link.download =
"dashboard-data.csv";


link.click();


}






document
.addEventListener(
"DOMContentLoaded",
()=>{


renderTable();


});



</script>