<!-- ================= DATA TABLE ================= -->


<section class="dashboard-card">



<div class="card-header">


<div>

<h2>
Recent Data
</h2>


<p>
Latest records from API
</p>


</div>




<div class="card-actions">


<button class="secondary-button"
onclick="exportCSV()">

↓ Export CSV

</button>



<button class="secondary-button"
onclick="window.print()">

🖨 Print

</button>



</div>


</div>







<div class="table-toolbar">


<div class="search-box">


<span>
🔍
</span>


<input id="searchInput"
       type="text"
       placeholder="Search documents, clients..."
       onkeyup="applyFilters()" />


</div>





<select id="clientFilter"
        onchange="applyFilters()">


<option value="">
All Clients
</option>


@foreach(var client in clientOptions)
{

<option value="@client">
@client
</option>

}


</select>






<select id="articleFilter"
        onchange="applyFilters()">


<option value="">
All Articles
</option>


@foreach(var article in articleOptions)
{

<option value="@article">
@article
</option>

}


</select>






<div class="date-range">


<span>
From
</span>


<input type="date"
       id="dateFrom"
       onchange="applyFilters()" />



<span>
To
</span>


<input type="date"
       id="dateTo"
       onchange="applyFilters()" />


</div>




<span id="recordCount"
      class="record-count">

Showing @totalRecords records

</span>



</div>







<div class="data-table-wrapper">


<table id="dashboardTable">


<thead>

<tr>

<th>Date</th>

<th>Document</th>

<th>Client</th>

<th>Article ID</th>

<th>Article</th>

<th>Qty</th>

<th>Size</th>

<th>Colour</th>

<th>Unit</th>

<th>MRP</th>


</tr>

</thead>





<tbody>


@foreach(var record in records)
{


var isoDate = record.DocDate.HasValue 
? record.DocDate.Value.ToString("yyyy-MM-dd")
: "";



<tr class="data-row"
    data-date="@isoDate">


<td>
@record.DocDateDisplay
</td>


<td class="doc-number">
@record.DocNo
</td>


<td class="client-name">
@record.ClientName
</td>


<td>
@record.ArtId
</td>


<td class="article-name">
@record.ArtName
</td>


<td class="number-cell">
@record.Qty.ToString("N0")
</td>


<td>
@record.Size
</td>


<td>

<span class="colour-badge">
@record.Colour
</span>

</td>


<td>
@record.Unit
</td>


<td class="mrp-cell">

₹@record.Mrp.ToString("N0")

</td>


</tr>


}



</tbody>


</table>



</div>
