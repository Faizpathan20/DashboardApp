@model List<DashboardApp.Models.DashboardRecord>

@{
    ViewData["Title"] = "Dashboard";

    var totalRecords = Model.Count;
    var totalQty = Model.Sum(x => x.Qty);
    var totalMrp = Model.Sum(x => x.Mrp);

    var uniqueClients = Model
        .Select(x => x.ClientName)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();

    var documentCount = Model
        .Select(x => x.DocNo)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .Count();

    var articleCount = Model
        .Select(x => x.ArtName)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();

    var records = Model
        .OrderByDescending(x => x.DocDate)
        .ToList();


    var clientOptions = Model
        .Select(x => x.ClientName)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();


    var articleOptions = Model
        .Select(x => x.ArtName)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();


    // Client Chart Data

    var topClients = Model
        .Where(x => !string.IsNullOrWhiteSpace(x.ClientName))
        .GroupBy(x => x.ClientName,StringComparer.OrdinalIgnoreCase)
        .Select(g => new
        {
            Client = g.Key,
            Qty = g.Sum(x => x.Qty)
        })
        .OrderByDescending(x=>x.Qty)
        .Take(5)
        .ToList();


    var topClientLabels =
        System.Text.Json.JsonSerializer.Serialize(
            topClients.Select(x=>x.Client)
        );


    var topClientValues =
        System.Text.Json.JsonSerializer.Serialize(
            topClients.Select(x=>x.Qty)
        );



    // Colour Chart Data

    var colourGroups = Model
        .Where(x=>!string.IsNullOrWhiteSpace(x.Colour))
        .GroupBy(x=>x.Colour,StringComparer.OrdinalIgnoreCase)
        .Select(g=>new
        {
            Colour=g.Key,
            Qty=g.Sum(x=>x.Qty)
        })
        .OrderByDescending(x=>x.Qty)
        .ToList();


    var colourLabels = colourGroups
        .Take(4)
        .Select(x=>x.Colour)
        .ToList();


    var colourValues = colourGroups
        .Take(4)
        .Select(x=>x.Qty)
        .ToList();


    var otherQty = colourGroups
        .Skip(4)
        .Sum(x=>x.Qty);


    if(otherQty > 0)
    {
        colourLabels.Add("Others");
        colourValues.Add(otherQty);
    }


    var colourLabelsJson =
        System.Text.Json.JsonSerializer.Serialize(colourLabels);


    var colourValuesJson =
        System.Text.Json.JsonSerializer.Serialize(colourValues);

}



